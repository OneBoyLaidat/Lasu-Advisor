# -----------------------------------------------------------------------------
# LASU Advisor - Environment Configuration Template (.env.example)
# -----------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Settings / Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Injected at runtime with the Cloud Run service URL.
APP_URL=""

# SUPABASE INTEGRATION
# Configure both values for live authentication and persistent data. Apply the
# SQL migration in supabase/migrations before deploying the app.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
