# -----------------------------------------------------------------------------
# LASU Advisor - Environment Configuration Template (.env.example)
# -----------------------------------------------------------------------------

# GEMINI_API_KEY: Server-only key for OCR of scanned PDF transcripts.
# Do not expose this value to the browser or use a VITE_ prefix.
GEMINI_API_KEY=""

# APP_URL: Public URL where this app is hosted (optional for local development).
APP_URL=""

# SUPABASE INTEGRATION
# Configure both values for live authentication and persistent data. Apply the
# SQL migration in supabase/migrations before deploying the app.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
